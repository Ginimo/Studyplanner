@startuml
skinparam style strictuml
title Sequence Diagram - Calculate Study Plan

actor Student
participant "ScheduleController" as SC
participant "DegreeProgramService" as DPS
participant "ScheduleService" as SS
participant "StudyModuleRepository" as SMR
participant "ScheduleRepository" as SR

Student -> SC : POST /degree-programs/{degreeProgramId}/schedule/calculate
activate SC

SC -> DPS : findDegreeProgramById(degreeProgramId)
activate DPS
DPS --> SC : Optional<DegreeProgram>
deactivate DPS

SC -> SS : calculateAndSaveSchedule(program)
activate SS

SS -> SMR : findAllStudyModulesByDegreeProgramId(degreeProgramId)
activate SMR
SMR --> SS : List<StudyModule>
deactivate SMR

note over SS
  Build dependency graph from prerequisiteKeys.
  Process modules layer by layer with Kahn's algorithm.
  Each layer becomes one Semester with studyModuleKeys.
end note

alt no cyclic dependency
    SS -> SR : saveSchedule(degreeProgramId, schedule)
    activate SR
    SR --> SS : void
    deactivate SR
    SS --> SC : void
else cyclic dependency
    SS --> SC : throws CyclicDependencyException
end

deactivate SS

alt schedule calculated successfully
    SC --> Student : redirect to schedule view\nflash successMessage
else cyclic dependency
    SC --> Student : redirect to schedule view\nflash errorMessage
end

deactivate SC
@enduml
