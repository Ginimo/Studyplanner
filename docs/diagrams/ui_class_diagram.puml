@startuml
title UI Class Diagram - Controllers, Forms and Views

skinparam packageStyle Rectangle
skinparam linetype ortho
skinparam roundcorner 6

skinparam package {
    BackgroundColor<<Controllers>> #F3E5F5
    BackgroundColor<<Forms>>       #FFF3E0
    BackgroundColor<<Views>>       #E3F2FD
    BorderColor                    #9E9E9E
    FontStyle                      Bold
}

skinparam class {
    BackgroundColor #FAFAFA
    BorderColor     #9E9E9E
}

skinparam arrow {
    Color           #555555
}

package "Controllers" <<Controllers>> {
    abstract class AbstractController
    class WelcomeController
    class DegreeProgramController
    class StudyModuleController
    class ScheduleController
}

package "Forms" <<Forms>> {
    class DegreeProgramForm {
        - name: String
        - description: String
        - maxDurationInSemesters: int
    }

    class StudyModuleForm {
        - studyModuleKey: String
        - name: String
        - description: String
        - ects: int
        - prerequisiteKeys: List<String>
        - offeredFrom: LocalDate
        - offeredTo: LocalDate
        - newEntry: boolean
    }
}

package "Views" <<Views>> {
    class DegreeProgramView <<record>> {
        - degreeProgramId: String
        - name: String
        - description: String
        - maxDurationInSemesters: int
    }

    class StudyModuleListView <<record>> {
        - studyModuleKey: String
        - name: String
        - ects: int
        - offeredFrom: LocalDate
        - offeredTo: LocalDate
        - hasPrerequisites: boolean
        - prerequisiteCount: int
    }

    class StudyModuleView <<record>> {
        - studyModuleKey: String
        - name: String
        - description: String
        - ects: int
        - prerequisiteKeys: List<String>
        - offeredFrom: LocalDate
        - offeredTo: LocalDate
    }

    class ScheduleView <<record>> {
        - calculatedAt: LocalDateTime
        - totalSemesters: int
    }

    class SemesterView <<record>> {
        - semesterNumber: int
        - studyModules: List<StudyModuleView>
        - totalEcts: int
        - joinedStudyModuleKeys: String
    }
}

AbstractController <|-- DegreeProgramController
AbstractController <|-- StudyModuleController
AbstractController <|-- ScheduleController

WelcomeController --> DegreeProgramService
DegreeProgramController --> DegreeProgramService
DegreeProgramController --> StudyModuleService
StudyModuleController --> DegreeProgramService
StudyModuleController --> StudyModuleService
ScheduleController --> DegreeProgramService
ScheduleController --> ScheduleService
ScheduleController --> StudyModuleService

DegreeProgramController ..> DegreeProgramForm
DegreeProgramController ..> DegreeProgramView
DegreeProgramController ..> StudyModuleListView

StudyModuleController ..> StudyModuleForm
StudyModuleController ..> DegreeProgramView
StudyModuleController ..> StudyModuleView

ScheduleController ..> DegreeProgramView
ScheduleController ..> ScheduleView
ScheduleController ..> SemesterView
ScheduleController ..> StudyModuleView

SemesterView "1" --> "*" StudyModuleView : resolves studyModuleKeys

@enduml
