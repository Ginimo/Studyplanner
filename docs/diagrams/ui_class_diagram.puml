@startuml

package "Forms" {
    class DegreeProgramForm {
        - name: String
        - description: String
        - maxDurationInSemesters: int
        + getName(): String
        + setName(name: String): void
        + getDescription(): String
        + setDescription(description: String): void
        + getMaxDurationInSemesters(): int
        + setMaxDurationInSemesters(maxDurationInSemesters: int): void
    }

    class StudyModuleForm {
        - studyModuleKey: String
        - name: String
        - description: String
        - ects: int
        - prerequisiteKeys: List<String>
        - offeredFrom: LocalDate
        - offeredTo: LocalDate
        - isNew: boolean
        + getStudyModuleKey(): String
        + setStudyModuleKey(studyModuleKey: String): void
        + getName(): String
        + setName(name: String): void
        + getDescription(): String
        + setDescription(description: String): void
        + getEcts(): int
        + setEcts(ects: int): void
        + getPrerequisiteKeys(): List<String>
        + setPrerequisiteKeys(prerequisiteKeys: List<String>): void
        + getOfferedFrom(): LocalDate
        + setOfferedFrom(offeredFrom: LocalDate): void
        + getOfferedTo(): LocalDate
        + setOfferedTo(offeredTo: LocalDate): void
        + getIsNew(): boolean
        + setIsNew(isNew: boolean): void
    }
}

package "Controllers" {
    class WelcomeController {
        - degreeProgramService: DegreeProgramService
        + WelcomeController(degreeProgramService: DegreeProgramService)
        + welcome(model: Model): String
    }

    class DegreeProgramController {
        - degreeProgramService: DegreeProgramService
        - studyModuleService: StudyModuleService
        + DegreeProgramController(degreeProgramService: DegreeProgramService, studyModuleService: StudyModuleService)
        + listDegreePrograms(model: Model): String
        + showCreateForm(model: Model): String
        + createDegreeProgram(form: DegreeProgramForm, result: BindingResult, model: Model, redirectAttributes: RedirectAttributes): String
        + showDetails(id: String, nameFilter: String, offeredAt: LocalDate, sortBy: String, sortDir: String, model: Model): String
        + showEditForm(id: String, model: Model): String
        + updateDegreeProgram(id: String, form: DegreeProgramForm, result: BindingResult, model: Model, redirectAttributes: RedirectAttributes): String
        + deleteDegreeProgram(id: String, redirectAttributes: RedirectAttributes): String
        - showCreateFormView(model: Model): String
        - showEditFormView(id: String, model: Model): String
        - toView(program: DegreeProgram): DegreeProgramView
    }

    class StudyModuleController {
        - degreeProgramService: DegreeProgramService
        - studyModuleService: StudyModuleService
        + StudyModuleController(degreeProgramService: DegreeProgramService, studyModuleService: StudyModuleService)
        + showCreateForm(degreeProgramId: String, model: Model): String
        + createStudyModule(degreeProgramId: String, form: StudyModuleForm, result: BindingResult, model: Model, redirectAttributes: RedirectAttributes): String
        + showDetails(degreeProgramId: String, studyModuleKey: String, model: Model): String
        + showEditForm(degreeProgramId: String, studyModuleKey: String, model: Model): String
        + updateStudyModule(degreeProgramId: String, studyModuleKey: String, form: StudyModuleForm, result: BindingResult, model: Model, redirectAttributes: RedirectAttributes): String
        + deleteStudyModule(degreeProgramId: String, studyModuleKey: String, redirectAttributes: RedirectAttributes): String
        - showCreateFormView(degreeProgramId: String, form: StudyModuleForm, model: Model): String
        - showEditFormView(degreeProgramId: String, studyModuleKey: String, form: StudyModuleForm, model: Model): String
        - addAvailableStudyModulesForPrerequisiteSelection(degreeProgramId: String, excludeStudyModuleKey: String, model: Model): void
        - requireProgram(id: String): DegreeProgram
        - toView(module: StudyModule): StudyModuleView
    }

    class ScheduleController {
        - degreeProgramService: DegreeProgramService
        - scheduleService: ScheduleService
        + ScheduleController(degreeProgramService: DegreeProgramService, scheduleService: ScheduleService)
        + showSchedule(degreeProgramId: String, model: Model): String
        + calculateSchedule(degreeProgramId: String, redirectAttributes: RedirectAttributes): String
        - requireProgram(degreeProgramId: String): DegreeProgram
        - toView(program: DegreeProgram): DegreeProgramView
    }
}

package "Views" {
    class DegreeProgramView {
        - id: String
        - name: String
        - description: String
        - maxDurationInSemesters: int
        + getId(): String
        + getName(): String
        + getDescription(): String
        + getMaxDurationInSemesters(): int
    }

    class ScheduleView {
        - calculatedAt: LocalDateTime
        - totalSemesters: int
        + getCalculatedAt(): LocalDateTime
        + getTotalSemesters(): int
    }

    class SemesterView {
        - semesterNumber: int
        - studyModules: List<StudyModuleView>
        - totalEcts: int
        - studyModuleKeys: String
        + getSemesterNumber(): int
        + getStudyModules(): List<StudyModuleView>
        + getTotalEcts(): int
        + getStudyModuleKeys(): String
    }

    record StudyModuleKey {
        + key: String
        + toString(): String
    }

    class StudyModuleListView {
        - studyModuleKey: StudyModuleKey
        - name: String
        - ects: int
        - offeredFrom: LocalDate
        - offeredTo: LocalDate
        - hasPrerequisites: boolean
        - prerequisiteCount: int
        + getStudyModuleKey(): StudyModuleKey
        + getName(): String
        + getEcts(): int
        + getOfferedFrom(): LocalDate
        + getOfferedTo(): LocalDate
        + isHasPrerequisites(): boolean
        + getPrerequisiteCount(): int
    }

    class StudyModuleView {
        - studyModuleKey: StudyModuleKey
        - name: String
        - description: String
        - ects: int
        - prerequisiteKeys: List<String>
        + getStudyModuleKey(): StudyModuleKey
        + getName(): String
        + getDescription(): String
        + getEcts(): int
        + getPrerequisiteKeys(): List<String>
    }
}

' Controller → Service dependencies (from domain diagram)
WelcomeController --> DegreeProgramService
DegreeProgramController --> DegreeProgramService
DegreeProgramController --> StudyModuleService
StudyModuleController --> DegreeProgramService
StudyModuleController --> StudyModuleService
ScheduleController --> DegreeProgramService
ScheduleController --> ScheduleService

' Controller → Form/View usage
DegreeProgramController ..> DegreeProgramForm
DegreeProgramController ..> DegreeProgramView
DegreeProgramController ..> StudyModuleListView

StudyModuleController ..> StudyModuleForm
StudyModuleController ..> StudyModuleView
StudyModuleController ..> DegreeProgramView

ScheduleController ..> DegreeProgramView
ScheduleController ..> ScheduleView
ScheduleController ..> SemesterView
ScheduleController ..> StudyModuleView

' View composition
SemesterView --> StudyModuleView
StudyModuleListView --> StudyModuleKey
StudyModuleView --> StudyModuleKey

@enduml
