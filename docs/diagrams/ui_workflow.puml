@startuml
title UI Workflow - Degree Programs and Study Modules
skinparam style strictuml

partition "Degree Program" {
    (*) --> "GET /degree-programs"
    "GET /degree-programs" --> "List degree programs"

    "List degree programs" --> "GET /degree-programs/new"
    "GET /degree-programs/new" --> "Show DegreeProgramForm"
    "Show DegreeProgramForm" --> "POST /degree-programs/new"
    "POST /degree-programs/new" --> "Validate form"
    if "valid?" then
        -->[yes] "DegreeProgramService.createDegreeProgram"
        "DegreeProgramService.createDegreeProgram" --> "Redirect to list"
    else
        -->[no] "Show form errors"
        "Show form errors" --> "Show DegreeProgramForm"
    endif

    "List degree programs" --> "GET /degree-programs/{degreeProgramId}"
    "GET /degree-programs/{degreeProgramId}" --> "Show details with filtered modules"
}

partition "Study Module" {
    "Show details with filtered modules" --> "GET /degree-programs/{degreeProgramId}/study-modules/new"
    "GET /degree-programs/{degreeProgramId}/study-modules/new" --> "Show StudyModuleForm"
    "Show StudyModuleForm" --> "POST /degree-programs/{degreeProgramId}/study-modules/new"
    "POST /degree-programs/{degreeProgramId}/study-modules/new" --> "Validate module form"
    if "module valid and key unique?" then
        -->[yes] "StudyModuleService.createStudyModule"
        "StudyModuleService.createStudyModule" --> "Invalidate saved schedule"
        "Invalidate saved schedule" --> "Redirect to degree program details"
    else
        -->[no] "Show module form errors"
        "Show module form errors" --> "Show StudyModuleForm"
    endif

    "Show details with filtered modules" --> "POST /degree-programs/{degreeProgramId}/study-modules/{studyModuleKey}/delete"
    "POST /degree-programs/{degreeProgramId}/study-modules/{studyModuleKey}/delete" --> "StudyModuleService.deleteStudyModule"
    "StudyModuleService.deleteStudyModule" --> "Remove prerequisite references"
    "Remove prerequisite references" --> "Invalidate saved schedule"
}

partition "Schedule" {
    "Show details with filtered modules" --> "GET /degree-programs/{degreeProgramId}/schedule"
    "GET /degree-programs/{degreeProgramId}/schedule" --> "Load saved schedule if present"
    "Load saved schedule if present" --> "Show schedule view"

    "Show schedule view" --> "POST /degree-programs/{degreeProgramId}/schedule/calculate"
    "POST /degree-programs/{degreeProgramId}/schedule/calculate" --> "ScheduleService.calculateAndSaveSchedule"
    if "calculation successful?" then
        -->[yes] "Save schedule and show success"
    else
        -->[no] "Show cycle error"
    endif
    "Save schedule and show success" --> (*)
    "Show cycle error" --> (*)
}

@enduml
