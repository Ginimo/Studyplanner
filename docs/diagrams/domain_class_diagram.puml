@startuml
title Domain Class Diagram - Studyplanner

top to bottom direction

skinparam packageStyle Rectangle
skinparam linetype ortho
skinparam roundcorner 6

skinparam package {
    BackgroundColor<<UI>>          #F3E5F5
    BackgroundColor<<Service>>     #E8F5E9
    BackgroundColor<<Model>>       #E3F2FD
    BackgroundColor<<Repository>>  #FFF8E1
    BackgroundColor<<Exception>>   #FDECEA
    BorderColor                    #9E9E9E
    FontStyle                      Bold
}

skinparam class {
    BackgroundColor #FAFAFA
    BorderColor     #9E9E9E
}

skinparam interface {
    BackgroundColor #FFFDE7
    BorderColor     #9E9E9E
}

skinparam arrow {
    Color           #555555
}

package "UI" <<UI>> {
    abstract class AbstractController
    class WelcomeController
    class DegreeProgramController
    class StudyModuleController
    class ScheduleController
}

package "Service" <<Service>> {
    interface DegreeProgramService {
        + createDegreeProgram(name, description, maxDurationInSemesters)
        + findDegreeProgramById(degreeProgramId)
        + findAllDegreePrograms()
        + updateDegreeProgram(degreeProgramId, name, description, maxDurationInSemesters)
        + deleteDegreeProgram(degreeProgramId)
    }

    class DegreeProgramServiceImpl

    interface StudyModuleService {
        + createStudyModule(studyModuleKey, degreeProgramId, ...)
        + findStudyModuleByKey(degreeProgramId, studyModuleKey)
        + findAllStudyModulesByDegreeProgramId(degreeProgramId)
        + findFilteredStudyModules(degreeProgramId, ...)
        + updateStudyModule(studyModuleKey, degreeProgramId, ...)
        + deleteStudyModule(degreeProgramId, studyModuleKey)
    }

    class StudyModuleServiceImpl

    interface ScheduleService {
        + calculateAndSaveSchedule(program)
        + findScheduleByDegreeProgramId(degreeProgramId)
        + deleteSchedule(degreeProgramId)
    }

    class ScheduleServiceImpl
}

package "Model" <<Model>> {
    class DegreeProgram {
        - degreeProgramId: String
        - name: String
        - description: String
        - maxDurationInSemesters: int
    }

    class StudyModule {
        - studyModuleKey: String
        - degreeProgramId: String
        - name: String
        - description: String
        - ects: int
        - prerequisiteKeys: List<String>
        - offeredFrom: LocalDate
        - offeredTo: LocalDate
    }

    class Schedule <<record>> {
        - calculatedAt: LocalDateTime
        - semesters: List<Semester>
    }

    class Semester <<record>> {
        - semesterNumber: int
        - studyModuleKeys: List<String>
    }
}

package "Repository" <<Repository>> {
    interface DegreeProgramRepository {
        + saveDegreeProgram(program)
        + findDegreeProgramById(degreeProgramId)
        + findAllDegreePrograms()
        + deleteDegreeProgram(degreeProgramId)
    }

    class JsonDegreeProgramRepository

    interface StudyModuleRepository {
        + saveStudyModule(module)
        + findStudyModuleByKey(degreeProgramId, studyModuleKey)
        + findAllStudyModulesByDegreeProgramId(degreeProgramId)
        + deleteAllStudyModulesByDegreeProgramId(degreeProgramId)
        + replaceAllStudyModulesForProgram(degreeProgramId, modules)
    }

    class JsonStudyModuleRepository

    interface ScheduleRepository {
        + saveSchedule(degreeProgramId, schedule)
        + findScheduleByDegreeProgramId(degreeProgramId)
        + deleteSchedule(degreeProgramId)
    }

    class JsonScheduleRepository
}

package "Exception" <<Exception>> {
    class CyclicDependencyException
    class DuplicateStudyModuleKeyException
}

' Layering hints
WelcomeController -[hidden]down-> DegreeProgramService
DegreeProgramController -[hidden]down-> DegreeProgramService
StudyModuleController -[hidden]down-> StudyModuleService
ScheduleController -[hidden]down-> ScheduleService
DegreeProgramService -[hidden]down-> DegreeProgramRepository
StudyModuleService -[hidden]down-> StudyModuleRepository
ScheduleService -[hidden]down-> ScheduleRepository
DegreeProgramService -[hidden]right-> DegreeProgram
ScheduleService -[hidden]right-> Schedule

AbstractController <|-- DegreeProgramController
AbstractController <|-- StudyModuleController
AbstractController <|-- ScheduleController

DegreeProgramServiceImpl ..|> DegreeProgramService
StudyModuleServiceImpl ..|> StudyModuleService
ScheduleServiceImpl ..|> ScheduleService

JsonDegreeProgramRepository ..|> DegreeProgramRepository
JsonStudyModuleRepository ..|> StudyModuleRepository
JsonScheduleRepository ..|> ScheduleRepository

Schedule "1" --> "*" Semester : contains
Semester "1" --> "*" StudyModule : references by studyModuleKeys
DegreeProgram "1" --> "*" StudyModule : owns
StudyModule "*" --> "*" StudyModule : prerequisites by prerequisiteKeys

WelcomeController -down-> DegreeProgramService
DegreeProgramController -down-> DegreeProgramService
DegreeProgramController -down-> StudyModuleService
StudyModuleController -down-> DegreeProgramService
StudyModuleController -down-> StudyModuleService
ScheduleController -down-> DegreeProgramService
ScheduleController -down-> ScheduleService
ScheduleController -down-> StudyModuleService

DegreeProgramServiceImpl -down-> DegreeProgramRepository
StudyModuleServiceImpl -down-> StudyModuleRepository
ScheduleServiceImpl -down-> StudyModuleRepository
ScheduleServiceImpl -down-> ScheduleRepository

ScheduleServiceImpl ..> Schedule
ScheduleServiceImpl ..> CyclicDependencyException
StudyModuleServiceImpl ..> DuplicateStudyModuleKeyException

@enduml
