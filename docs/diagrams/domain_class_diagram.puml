@startuml

skinparam packageStyle Rectangle
skinparam linetype ortho
skinparam roundcorner 6

skinparam package {
    BackgroundColor<<Model>>       #E3F2FD
    BackgroundColor<<Service>>     #E8F5E9
    BackgroundColor<<Repository>>  #FFF8E1
    BackgroundColor<<Exception>>   #FDECEA
    BackgroundColor<<UI>>          #F3E5F5
    BorderColor                    #9E9E9E
    FontStyle                      Bold
}

skinparam class {
    BackgroundColor #FAFAFA
    BorderColor     #9E9E9E
}

skinparam interface {
    BackgroundColor #FFFDE7
    BorderColor     #9E9E9E
}

skinparam arrow {
    Color           #555555
}

package "Model" <<Model>> {
    class DegreeProgram {
        - id: String
        - name: String
        - description: String
        - maxDurationInSemesters: int
        + getId(): String
        + getName(): String
        + getDescription(): String
        + getMaxDurationInSemesters(): int
    }

    class StudyModule {
        - studyModuleKey: String
        - degreeProgramId: String
        - name: String
        - description: String
        - ects: int
        - prerequisiteKeys: List<String>
        - offeredFrom: LocalDate
        - offeredTo: LocalDate
        + getStudyModuleKey(): String
        + getDegreeProgramId(): String
        + getName(): String
        + getDescription(): String
        + getEcts(): int
        + getPrerequisiteKeys(): List<String>
        + getOfferedFrom(): LocalDate
        + getOfferedTo(): LocalDate
    }

    class Schedule {
        - calculatedAt: LocalDateTime
        - semesters: List<Semester>
        + getCalculatedAt(): LocalDateTime
        + addSemester(semester: Semester): void
        + getSemesters(): List<Semester>
        + getTotalSemesters(): int
    }

    class Semester {
        - semesterNumber: int
        - studyModules: List<StudyModule>
        + getSemesterNumber(): int
        + addStudyModule(module: StudyModule): void
        + getStudyModules(): List<StudyModule>
        + getTotalEcts(): int
    }
}

package "Exception" <<Exception>> {
    class CyclicDependencyException {
        + CyclicDependencyException(remainingModuleKeys: List<String>)
    }
    CyclicDependencyException --|> RuntimeException
}

package "Service" <<Service>> {
    together {
        interface DegreeProgramService {
            + create(program: DegreeProgram): void
            + findById(id: String): Optional<DegreeProgram>
            + findAll(): List<DegreeProgram>
            + update(program: DegreeProgram): void
            + delete(id: String): void
        }

        class DegreeProgramServiceImpl {
            - repository: DegreeProgramRepository
        }
    }

    together {
        interface StudyModuleService {
            + create(module: StudyModule): void
            + findByKey(degreeProgramId: String, key: String): Optional<StudyModule>
            + findAllByDegreeProgramId(degreeProgramId: String): List<StudyModule>
            + update(module: StudyModule): void
            + delete(degreeProgramId: String, key: String): void
        }

        class StudyModuleServiceImpl {
            - repository: StudyModuleRepository
        }
    }

    together {
        interface ScheduleService {
            + calculate(program: DegreeProgram): Schedule
        }

        class ScheduleServiceImpl {
            - studyModuleService: StudyModuleService
            + calculate(program: DegreeProgram): Schedule
        }
    }

    DegreeProgramServiceImpl ..|> DegreeProgramService
    StudyModuleServiceImpl ..|> StudyModuleService
    ScheduleServiceImpl ..|> ScheduleService
}

package "UI Orchestration" <<UI>> {
    together {
        class DegreeProgramController
        class ScheduleController
        class StudyModuleController
        class WelcomeController
    }
}

package "Repository" <<Repository>> {
    together {
        interface DegreeProgramRepository {
            + save(program: DegreeProgram): void
            + findById(id: String): Optional<DegreeProgram>
            + findAll(): List<DegreeProgram>
            + delete(id: String): void
        }

        class InMemoryDegreeProgramRepository {
            - store: Map<String, DegreeProgram>
        }
    }

    together {
        interface StudyModuleRepository {
            + save(module: StudyModule): void
            + findByKey(degreeProgramId: String, key: String): Optional<StudyModule>
            + findAllByDegreeProgramId(degreeProgramId: String): List<StudyModule>
            + delete(degreeProgramId: String, key: String): void
        }

        class InMemoryStudyModuleRepository {
            - store: Map<String, StudyModule>
        }
    }

    InMemoryStudyModuleRepository ..|> StudyModuleRepository
    InMemoryDegreeProgramRepository ..|> DegreeProgramRepository
}

' Data Associations
Schedule "1" --> "*" Semester : contains
Semester "1" --> "*" StudyModule : consists of
DegreeProgram "1" --> "0..*" StudyModule : includes
StudyModule "*" --> "*" StudyModule : has prerequisites

' Schedule is computed from a DegreeProgram by ScheduleService; DegreeProgram does not hold a Schedule reference
ScheduleServiceImpl ..> Schedule : creates

' Logic Associations (Dependency Injection)
WelcomeController --> DegreeProgramService
DegreeProgramController --> DegreeProgramService
DegreeProgramController --> StudyModuleService
StudyModuleController --> DegreeProgramService
StudyModuleController --> StudyModuleService
ScheduleController --> ScheduleService
ScheduleController --> DegreeProgramService

DegreeProgramServiceImpl --> DegreeProgramRepository
StudyModuleServiceImpl --> StudyModuleRepository
ScheduleServiceImpl --> StudyModuleService

' Exception usage
ScheduleServiceImpl ..> CyclicDependencyException : throws
ScheduleController ..> CyclicDependencyException : catches

' Layout hints (invisible — rank enforcement only)
DegreeProgramService -[hidden]-> DegreeProgramController
DegreeProgramService -[hidden]-> StudyModuleController
DegreeProgramService -[hidden]-> ScheduleController
DegreeProgramService -[hidden]-> WelcomeController
StudyModuleService -[hidden]-> DegreeProgramController
StudyModuleService -[hidden]-> StudyModuleController
StudyModuleService -[hidden]-> ScheduleController
ScheduleService -[hidden]-> ScheduleController
ScheduleService -[hidden]-> DegreeProgramController

@enduml
