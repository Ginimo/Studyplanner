@startuml
title Activity Diagram - Schedule Calculation

skinparam activity {
    BackgroundColor #F9F9F9
    BorderColor     #607D8B
    DiamondBackgroundColor #FFF9C4
    DiamondBorderColor     #F57F17
    StartColor #2E7D32
    EndColor   #2E7D32
    ArrowColor #546E7A
}
skinparam note {
    BackgroundColor #FFFDE7
    BorderColor     #F9A825
}

start
:load StudyModules for degreeProgramId;
:build moduleMap;
:build inDegree from prerequisiteKeys;
:build dependents as reverse prerequisite lookup;
:seed ready with modules where inDegree = 0;

note right
  Kahn's algorithm groups ready modules into layers.
  One layer corresponds to one Semester.
  Complexity: O(V + E).
end note

while (ready is not empty?) is (yes)
  :copy ready to current layer;
  :clear ready for next semester;
  :create Semester with current studyModuleKeys;
  :decrement inDegree for dependent modules;
  :add newly unblocked modules to ready;
  :add Semester to Schedule;
endwhile (no)

if (all modules placed?) then (yes)
  :save Schedule for degreeProgramId;
  stop
else (no)
  :throw CyclicDependencyException;
  stop
endif

@enduml
