@startuml
skinparam style strictuml
title Sequence Diagram - Create Study Module

actor Student
participant "StudyModuleController" as SMC
participant "StudyModuleService" as SMS
participant "StudyModuleRepository" as SMR
participant "ScheduleService" as SS

Student -> SMC : POST /degree-programs/{degreeProgramId}/study-modules/new
activate SMC

SMC -> SMC : validate StudyModuleForm

alt form has validation errors
    SMC --> Student : show form with errors
else valid form
    SMC -> SMS : createStudyModule(studyModuleKey, degreeProgramId, ...)
    activate SMS

    SMS -> SMR : findStudyModuleByKey(degreeProgramId, studyModuleKey)
    activate SMR
    SMR --> SMS : Optional<StudyModule>
    deactivate SMR

    alt key already exists
        SMS --> SMC : throws DuplicateStudyModuleKeyException
        SMC --> Student : show form with duplicate-key error
    else key is unique
        SMS -> SMR : saveStudyModule(new StudyModule(...))
        activate SMR
        SMR --> SMS : void
        deactivate SMR

        SMS -> SS : deleteSchedule(degreeProgramId)
        activate SS
        SS --> SMS : void
        deactivate SS

        SMS --> SMC : void
        SMC --> Student : redirect to degree program details\nflash successMessage
    end

    deactivate SMS
end

deactivate SMC
@enduml
