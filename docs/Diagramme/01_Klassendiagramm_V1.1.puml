@startuml

package "Model" {
    class DegreeProgram{
    - program_id: String
    - name: String
    - description: String
    - maxDurationInSemesters: int
    }

    class StudyModule{
    - studyModuleKey: String
    - name: String
    - description: String
    - ects: int
    - prerequisiteKeys: List<String>
    - offeredFrom: LocalDate
    - offeredTo: LocalDate
    }

    class Schedule{
    - calculatedAt: LocalDateTime
    - totalSemesters: int
    }

    class Semester{
    - semesterNumber: int
    - totalEcts: int
    }
}

package "Service" {
    interface DegreeProgramService{}
    interface StudyModuleService{}
    interface ScheduleService{}

    class DegreeProgramServiceImpl{
    - programs: List<DegreeProgram>
    + create(program: DegreeProgram): void
    + findByID(program_id: String): Optional<DegreeProgram>
    + findAll(): List<DegreeProgram>
    + update(program: DegreeProgram): void
    + delete(program_id: String): void
    }

    class StudyModuleServiceImpl{
    - modules: List<StudyModule>
    + create(module: StudyModule): void
    + findByKey(studyModuleKey: String): Optional<StudyModule>
    + findAll(program_id: int): List<StudyModule>
    + update(module: StudyModule): void
    + delete(studyModuleKey: String): void
    }

    class ScheduleServiceImpl{
    + calculate(program: DegreeProgram): Schedule
    - sortByPrerequisites(modules: List<StudyModule>): List<StudyModule>
    }

    DegreeProgramServiceImpl ..|> DegreeProgramService
    StudyModuleServiceImpl ..|> StudyModuleService
    ScheduleServiceImpl ..|> ScheduleService
}

' Assoziationen Daten
DegreeProgram "1" --> "0..1" Schedule : hat
Schedule "1" --> "*" Semester : beinhalten
Semester "*" --> "*" StudyModule : bestehen aus
DegreeProgram "*" --> "*" StudyModule : haben

' Assoziationen Logik
DegreeProgramServiceImpl --> DegreeProgram : macht CRUD für
StudyModuleServiceImpl --> StudyModule : macht CRUD für
ScheduleServiceImpl --> Schedule : berechnet
ScheduleServiceImpl --> StudyModuleService : nutzt

@enduml