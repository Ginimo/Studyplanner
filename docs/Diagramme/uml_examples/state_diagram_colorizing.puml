@startuml
skinparam state {
    BorderThickness 7
    BorderColor #777
    BackgroundColor #ACF
}

state FooGradient #pink-green ##44DDDD
state FooDashed #pink|palegreen ##[dashed]blue {
}
state FooDotted ##[dotted]blue {
}
state FooBold #line.bold {
}
state Foo1 ##[dotted]green {
    state inner1 ##[dotted]yellow
    state inner2 #pink;line:red;line.bold;text:red
}

state out ##[dotted]gold
state Foo2 ##[bold]green {
    state inner2 #line.bold ##[dotted]yellow
}

inner1 -> inner2
out -[dashed,thickness=8]> inner2
@enduml