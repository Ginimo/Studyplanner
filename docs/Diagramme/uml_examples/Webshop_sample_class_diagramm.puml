@startuml

' Klassen
class Benutzer {
  - name: String
  - email: String
  - password: String
}

class Administrator
class Kunde {
   ' Option 1: aber ohne Visualisierung
   '- adresse: Adresse
}
class Produkt {
  - name: String
  - beschreibung: String
  - preis: Float
}
class Kategorie {
  - name: String
}
class Warenkorb
class Bestellung {
  - datum: Date
  - status: String
}
class Zahlung {
  - zahlungsmethode: String
  - status: String
}

'class Delivery {
'   + deliveryDate: Date
'}

class Adresse {
   - Street: String
}

' Vererbung
Administrator --|> Benutzer
Kunde --|> Benutzer

' Assoziationen
Kunde "1" --> "1" Warenkorb : besitzt
Kunde "1" --> "1" Adresse : wohnt
Warenkorb "1" --> "*" Produkt : enthält
Kunde "1" --> "*" Bestellung : gibt
Bestellung "1" --> "*" Produkt : enthält
Bestellung "1" --> "1" Zahlung : bezahlt

' Optional: Kategorie zu Produkt
Kategorie "1" --> "*" Produkt : enthält

@enduml